{
	"name": "@luxuride-pi/devcontainer",
	"version": "0.1.1",
	"description": "pi extension: run project commands inside the project's devcontainer",
	"keywords": [
		"devcontainer",
		"docker",
		"pi-extension",
		"pi-package"
	],
	"type": "module",
	"license": "MIT",
	"files": [
		"index.ts",
		"config.ts",
		"docker.ts",
		"exec.ts",
		"features-index.ts",
		"jsonc.ts",
		"override.ts",
		"ports.ts",
		"progress.ts",
		"provision.ts",
		"render.ts",
		"run-in-container.ts",
		"scaffold.ts",
		"types.ts"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "tsc --noEmit false --outDir ./.smoke-build && node ./.smoke-build/smoke.js; code=$?; rm -rf ./.smoke-build; exit $code"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@earendil-works/pi-tui": "^0.87.1",
		"@types/node": "^22.0.0",
		"typebox": "^1.3.27",
		"typescript": "^5.6.0"
	}
}
